        .home-matched-page {
          background-color: #ffffff;
          color: #071921;
          min-height: 100vh;
        }
        .home-matched-container {
          max-width: 1180px;
          margin: 0 auto;
          padding: 48px 24px 72px;
        }
        .home-matched-eyebrow {
          margin: 0 0 8px;
          font-size: 0.9rem;
          font-weight: 700;
          color: #0f9d76;
          letter-spacing: 0.02em;
        }
        .home-matched-h1 {
          margin: 0;
          font-size: 2.25rem;
          font-weight: 700;
          line-height: 1.2;
          color: #071921;
        }
        .home-matched-lead {
          margin: 12px 0 0;
          max-width: 760px;
          font-size: 1.05rem;
          line-height: 1.65;
          color: #334155;
        }
        .home-matched-list {
          margin-top: 32px;
          display: flex;
          flex-direction: column;
          gap: 20px;
        }
        .home-matched-item {
          background-color: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 14px;
          padding: 24px 28px;
          box-shadow: 0 4px 16px rgba(7, 25, 33, 0.04);
        }
        .home-matched-tag {
          display: inline-block;
          font-size: 0.8rem;
          font-weight: 700;
          color: #0f9d76;
          margin-bottom: 6px;
        }
        .home-matched-item-title {
          margin: 0;
          font-size: 1.35rem;
          font-weight: 700;
          color: #071921;
        }
        .home-matched-item-desc {
          margin: 8px 0 0;
          font-size: 1rem;
          line-height: 1.65;
          color: #334155;
        }
        .home-matched-cta-row {
          margin-top: 36px;
          display: flex;
          flex-wrap: wrap;
          gap: 14px;
        }
        .home-matched-btn-primary {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          background-color: #0f9d76;
          color: #ffffff;
          text-decoration: none;
          font-weight: 600;
          font-size: 0.95rem;
          padding: 12px 22px;
          border-radius: 999px;
        }
        .home-matched-btn-secondary {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          background-color: #f8fafc;
          color: #071921;
          border: 1px solid #cbd5e1;
          text-decoration: none;
          font-weight: 600;
          font-size: 0.95rem;
          padding: 12px 22px;
          border-radius: 999px;
        }
