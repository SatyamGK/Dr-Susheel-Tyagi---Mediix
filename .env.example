# Public site URL (used for sitemap, robots and canonical metadata), no trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (server-side only). Use the Project URL and service_role key from
# Supabase Dashboard -> Project Settings -> API. NEVER prefix the service key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional extra secret for hashing rate-limit identifiers. Use a long random value.
RATE_LIMIT_SALT=

# Optional appointment notifications (database storage works without these)
RESEND_API_KEY=
APPOINTMENT_TO_EMAIL=
APPOINTMENT_FROM_EMAIL=
APPOINTMENT_WEBHOOK_URL=
